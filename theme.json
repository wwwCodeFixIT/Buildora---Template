{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1280px"
    },
    "color": {
      "defaultPalette": false,
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "palette": [
        { "slug": "ink", "name": "Ink", "color": "#111315" },
        { "slug": "paper", "name": "Paper", "color": "#FFFFFF" },
        { "slug": "surface", "name": "Surface", "color": "#F4F5F2" },
        { "slug": "muted", "name": "Muted", "color": "#62676B" },
        { "slug": "brand", "name": "Brand", "color": "#F2B705" },
        { "slug": "brand-dark", "name": "Brand Dark", "color": "#C89400" }
      ]
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "units": ["px", "rem", "vw", "%"],
      "spacingSizes": [
        { "slug": "10", "name": "2XS", "size": "0.25rem" },
        { "slug": "20", "name": "XS", "size": "0.5rem" },
        { "slug": "30", "name": "S", "size": "0.75rem" },
        { "slug": "40", "name": "M", "size": "1rem" },
        { "slug": "50", "name": "L", "size": "1.5rem" },
        { "slug": "60", "name": "XL", "size": "2rem" },
        { "slug": "70", "name": "2XL", "size": "clamp(2.5rem, 5vw, 4rem)" },
        { "slug": "80", "name": "3XL", "size": "clamp(4rem, 8vw, 7rem)" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "System Sans",
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "xs", "name": "XS", "size": "0.875rem" },
        { "slug": "sm", "name": "S", "size": "1rem" },
        { "slug": "md", "name": "M", "size": "1.125rem" },
        { "slug": "lg", "name": "L", "size": "clamp(1.25rem, 2vw, 1.5rem)" },
        { "slug": "xl", "name": "XL", "size": "clamp(2rem, 4vw, 3rem)" },
        { "slug": "hero", "name": "Hero", "size": "clamp(2.75rem, 7vw, 5.75rem)" }
      ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "slug": "soft",
          "name": "Soft",
          "shadow": "0 18px 50px rgba(17, 19, 21, 0.10)"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|paper",
      "text": "var:preset|color|ink"
    },
    "spacing": {
      "blockGap": "var:preset|spacing|50",
      "padding": {
        "left": "clamp(1rem, 4vw, 2rem)",
        "right": "clamp(1rem, 4vw, 2rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "var:preset|font-size|sm",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontWeight": "750",
          "lineHeight": "1.05",
          "letterSpacing": "-0.035em"
        }
      },
      "link": {
        "color": { "text": "var:preset|color|ink" },
        ":hover": { "color": { "text": "var:preset|color|brand-dark" } },
        ":focus": { "outline": { "color": "var:preset|color|ink", "style": "solid", "width": "2px" } }
      },
      "button": {
        "border": { "radius": "999px" },
        "color": {
          "background": "var:preset|color|brand",
          "text": "var:preset|color|ink"
        },
        "spacing": {
          "padding": {
            "top": "0.85rem",
            "right": "1.25rem",
            "bottom": "0.85rem",
            "left": "1.25rem"
          }
        },
        "typography": { "fontWeight": "700" },
        ":hover": { "color": { "background": "var:preset|color|brand-dark" } },
        ":focus": { "outline": { "color": "var:preset|color|ink", "style": "solid", "width": "3px" } }
      }
    },
    "blocks": {
      "core/navigation": {
        "typography": { "fontWeight": "650" }
      }
    }
  },
  "templateParts": [
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
