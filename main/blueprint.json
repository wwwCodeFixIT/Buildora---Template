{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/",
  "login": true,
  "preferredVersions": {
    "php": "8.3",
    "wp": "7.1"
  },
  "siteOptions": {
    "blogname": "Buildora",
    "blogdescription": "Construction & Home Services"
  },
  "steps": [
    {
      "step": "installTheme",
      "themeData": {
        "resource": "bundled",
        "path": "/buildora.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "writeFile",
      "path": "/tmp/buildora-demo-seed.php",
      "data": {
        "resource": "bundled",
        "path": "/demo-seed.php"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require '/tmp/buildora-demo-seed.php';"
    }
  ]
}
