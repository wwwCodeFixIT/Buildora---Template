{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/wp-admin/site-editor.php",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "siteOptions": {
    "blogname": "Buildora",
    "blogdescription": "Construction & Home Services"
  },
  "login": true,
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "create-block-theme"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "git:directory",
        "url": "https://github.com/wwwCodeFixIT/Buildora---Template",
        "ref": "main",
        "refType": "branch"
      },
      "options": {
        "activate": true
      }
    }
  ]
}
