{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/wp-admin/site-editor.php",
  "preferredVersions": {
    "php": "8.3",
    "wp": "7.1"
  },
  "siteOptions": {
    "blogname": "Buildora",
    "blogdescription": "Construction & Home Services"
  },
  "login": true,
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "create-block-theme"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/wwwCodeFixIT/Buildora---Template/playground-artifacts/main/buildora.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "writeFile",
      "path": "/tmp/buildora-demo-seed.php",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/wwwCodeFixIT/Buildora---Template/main/.github/playground/demo-seed.php"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require '/tmp/buildora-demo-seed.php';"
    }
  ]
}
