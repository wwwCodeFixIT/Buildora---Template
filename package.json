{
  "name": "buildora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,scss}\" \"scripts/**/*.mjs\" \"playground/**/*.json\" \".devcontainer/**/*.json\" \"*.{json,js,md}\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.{js,scss}\" \"scripts/**/*.mjs\" \"playground/**/*.json\" \".devcontainer/**/*.json\" \"*.{json,js,md}\" \".github/**/*.{yml,yaml}\"",
    "check": "npm run lint && npm run format:check && npm run build",
    "package": "npm run build && bash scripts/build-theme-zip.sh",
    "configure:cloud": "node scripts/configure-cloud.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.9.0",
    "prettier": "3.9.6",
    "sass": "1.103.1",
    "vite": "8.2.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
